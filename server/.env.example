# Connexion PostgreSQL (valeurs du docker-compose.yml : même mot de passe que POSTGRES_PASSWORD dans ../.env)
DATABASE_URL=postgres://ghanja:changez-moi@localhost:5437/ghanja
DATABASE_SSL=false

# Clé secrète des jetons de connexion : mettre une longue chaîne aléatoire
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire

# 3005 pour ne pas entrer en conflit avec les autres projets
PORT=3005

# Emails des promotions (Mailpit du docker-compose : boîte de réception sur http://localhost:8026)
# Laisser SMTP_HOST vide pour n'envoyer que les notifications dans l'application
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
MAIL_FROM="El Ghanja Make-up <contact@elghanja.tn>"
